    { "source": "/portfolio", "destination": "/", "permanent": true },
    { "source": "/portfolio/:path*", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/contact/:path*", "destination": "/#contact", "permanent": true }
  ]
